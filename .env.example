# Скопируйте в .env и заполните: cp .env.example .env
# .env не коммитится (есть в .gitignore).

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Username бота без @: используется в ссылках «разместить объявление» и «Место»
BOT_USERNAME=

# Чат модерации (канал или группа): сюда приходят новые объявления, модераторы отвечают на пост
# словом approved (опубликовать) или причиной отказа. Бот должен быть администратором.
# Если обычную группу преобразуют в супергруппу, её ID меняется (начнётся с -100) — обновите значение.
MODERATION_CHANNEL_ID=
# Публичный канал с объявлениями
MARKET_CHANNEL_ID=
MARKET_CHANNEL_USERNAME=
# Канал рассылки («Маркет Пуши»): каждый пост пересылается всем пользователям бота
BROADCAST_CHANNEL_ID=
# Контакт для связи по техническим вопросам: показывается в /authors и в сообщениях об ошибках
SUPPORT_CONTACT=@sculp2ra

# --- Яндекс Геокодер (необязательно) ---
# Без ключа вместо адреса места встречи в объявлении будут координаты.
# Ключ: https://developer.tech.yandex.ru/services/ → «JavaScript API и HTTP Геокодер»
YANDEX_GEOCODER_API_KEY=

# --- PostgreSQL в docker compose ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Порт БД на хосте для локальной разработки (compose.override.yaml, слушает только 127.0.0.1).
# На сервере база доступна только контейнеру бота через внутреннюю сеть Docker.
POSTGRES_PORT=

# --- Подключение к БД при запуске без Docker (в compose задаётся автоматически) ---
DB_URL=
DB_USER=
DB_PASSWORD=

# --- Мониторинг ---
# Чат для алертов (Alertmanager шлёт их через этого же бота). Пусто — алерты видны только в веб-интерфейсе Prometheus.
# Личный чат: ваш Telegram ID (сначала напишите боту /start). Канал или группа: ID, бот должен быть участником.
ALERT_CHAT_ID=
# Порт веб-интерфейса Prometheus на хосте (слушает только 127.0.0.1; на сервере — через SSH-туннель)
PROMETHEUS_PORT=
# Сколько хранить метрики, например 30d
PROMETHEUS_RETENTION=
# Порт /metrics и /health бота при запуске без Docker (в образе — 8081)
METRICS_PORT=

# --- Образ бота. Локально собирается из исходников; на сервере .env целиком генерирует деплой из GitHub Actions ---
# BOT_IMAGE=

# --- Логирование: TRACE, DEBUG, INFO, WARN, ERROR ---
LOG_LEVEL=
